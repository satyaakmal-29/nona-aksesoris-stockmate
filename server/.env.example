# Salin menjadi .env lalu isi nilainya. File .env TIDAK boleh di-push.

# Koneksi PostgreSQL: postgresql://USER:PASSWORD@HOST:PORT/NAMA_DB?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/stockmanagement?schema=public"

# Rahasia sesi login (isi teks acak yang panjang).
# Juga dipakai mengenkripsi App Password Gmail toko: jika diganti, simpan ulang App Password di Pengaturan.
SESSION_SECRET=ganti-dengan-teks-acak-yang-panjang

# Port server API
PORT=8000

# Alamat client (untuk CORS & cookie sesi)
CLIENT_URL=http://localhost:3000

# (Opsional) Server SMTP selain Gmail untuk email nota. Biarkan tertutup = Gmail (smtp.gmail.com:465).
# Gmail toko & App Password diatur Super Admin di menu Pengaturan, BUKAN di file ini.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
